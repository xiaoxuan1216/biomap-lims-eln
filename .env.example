SESSION_SECRET=<至少32字节的独立随机值>
BIOMAP_AUTH_USERNAME=<管理员账号>
BIOMAP_AUTH_PASSWORD=<至少12字节的独立强密码>
BIOMAP_AUTH_DISPLAY_NAME=BioMap 管理员

DATABASE_URL=<填你的值>
KIMI_API_KEY=<可选，启用开放式模型问答；仅保存在服务端>
KIMI_API_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6
KIMI_ALLOW_LAB_CONTEXT=false
PUBLIC_BASE_URL=http://localhost:3100
API_TOKENS=<名称:至少24位令牌:read|write,逗号分隔>
